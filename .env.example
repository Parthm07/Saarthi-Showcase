# Copy to .env and fill in. .env is gitignored; never commit it.

# Railway Postgres, PUBLIC url (Settings > Networking > Public access).
# Temporary: once FastAPI is deployed inside Railway, the laptop pushes to
# the API over HTTPS instead and public access on the DB gets turned off.
# Do NOT paste this line as-is. Replace the whole value.
# Laptop  -> Railway Postgres -> Variables -> DATABASE_PUBLIC_URL (reveal it,
#            the masked form is literally "********" and will not connect).
# Deployed -> set it to ${{Postgres.DATABASE_URL}} so it uses Railway's
#            internal network: no public exposure and no proxy latency.
CLOUD_DB_URL=

# Optional: override the Tally endpoint (default http://localhost:9000)
# TALLY_URL=http://localhost:9000

# ---------- website API (api.py) ----------
# Signs the session cookie. Generate once and keep it: changing it signs
# every salesperson out.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# OAuth 2.0 Client ID (Web application) from console.cloud.google.com.
# Authorised JavaScript origin must be the site's own URL. Setting this
# switches on real Google sign-in AND permanently disables DEV_LOGIN.
GOOGLE_CLIENT_ID=

# Where the website's static files are. Defaults to this repository's web/
# folder on both the laptop and Railway. Override only for deliberate development.
# WEB_DIR=web

# Not needed: secure cookies switch on automatically wherever
# RAILWAY_ENVIRONMENT is present. Set HTTPS_ONLY=1 only to force it on some
# other TLS host.
# HTTPS_ONLY=1

# Password-free sign-in for local development. Dies automatically once
# GOOGLE_CLIENT_ID is set. NEVER set this on Railway.
# DEV_LOGIN=1

# Owner login used by the manual integration scripts against a test environment.
# TEST_OWNER_EMAIL=test.owner@example.com

# Local cumulative SQLite backups required before seven-day cloud cleanup.
# Defaults to cloud_backup/local_archive under this project. For recovery
# after a laptop/disk failure, choose a separately backed-up volume/location.
# LOCAL_BACKUP_DIR=D:/SaarthiBackups
